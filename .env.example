# Sybilion forecasting API
SYBILION_API_KEY=your-sybilion-key-here
SYBILION_BASE_URL=https://api.sybilion.dev

# Featherless (OpenAI-compatible inference endpoint)
FEATHERLESS_API_KEY=your-featherless-key-here
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Model choices (swappable strings)
KEYWORD_MODEL=mistralai/Mistral-Small-3.2-24B-Instruct-2506
EXPLANATION_MODEL=mistralai/Mistral-Large-Instruct-2411

# --- Voice narration (optional) ---------------------------------------------
# Provider: "auto" (NVIDIA first, fall back to the local OS voice), "nvidia", or
# "local". Featherless serves text only (no /v1/audio/speech), so the always-on
# fallback is the local engine. Leave everything default to run with the local
# voice; on a non-macOS host with no NVIDIA key the player simply hides.
VOICE_PROVIDER=auto

# NVIDIA Riva TTS (gRPC via NVIDIA Cloud Functions). The TTS models are NOT on the
# OpenAI-compatible chat endpoint — install the optional client and run with it:
#   uv run --extra voice streamlit run app.py
# The defaults below are the VERIFIED-WORKING magpie-tts-multilingual model + voice.
# The older fastpitch/radtts gRPC function ids are now NOT_FOUND on current NVCF
# accounts; copy a function id from a model's API tab on build.nvidia.com to swap.
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RIVA_URI=grpc.nvcf.nvidia.com:443
NVIDIA_TTS_MODEL=magpie-tts-multilingual
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Sofia
NVIDIA_RPM_LIMIT=40

# Local OS voice (macOS `say`) — the always-available fallback. Empty = system default.
LOCAL_TTS_VOICE=

# --- Push-to-talk speech-to-text (optional) ---------------------------------
# The voice assistant records a clip and transcribes it. ASR ladder: NVIDIA Riva ASR
# → HuggingFace Whisper → LOCAL Whisper (offline, no key — install with
# `uv sync --extra localasr`). ASR_PROVIDER picks order: "auto" (nvidia→hf→local),
# "nvidia", "hf", or "local" (fully offline). With local Whisper installed the mic
# works with NO cloud key; with nothing configured the app runs text-only.
ASR_PROVIDER=auto
# Local Whisper model size (tiny/base/small/medium/large). "base" is a good default.
LOCAL_ASR_MODEL=base

# NVIDIA Riva ASR reuses NVIDIA_API_KEY + NVIDIA_RIVA_URI above; it needs its own
# function id (copy from a speech-recognition model's API tab on build.nvidia.com).
# Leave empty to skip straight to the HuggingFace fallback.
NVIDIA_ASR_FUNCTION_ID=

# HuggingFace Inference API — the Whisper fallback (plain HTTPS, no extra deps).
# NOTE: the legacy api-inference.huggingface.co host is RETIRED; the serverless API now
# routes through router.huggingface.co/hf-inference (the code rewrites a stale value
# automatically, so an old .env still works). The token must have the
# "Make calls to Inference Providers" permission — set it at
# https://huggingface.co/settings/tokens (a fine-grained token with that scope).
HF_API_KEY=hf_your-key-here
HF_BASE_URL=https://router.huggingface.co
HF_ASR_MODEL=openai/whisper-large-v3
